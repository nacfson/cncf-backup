{
  "schema_version": 1,
  "default_scope": "text-svg",
  "projects": [
    {
      "slug": "kubernetes",
      "name": "Kubernetes",
      "layer": "Orchestration & Core",
      "layer_slug": "orchestration-core",
      "format": "markdown",
      "website": "https://kubernetes.io/docs/",
      "sources": [
        {
          "repo": "kubernetes/website",
          "branch": "main",
          "paths": [
            { "src": "content/en/docs", "dest": "" },
            { "src": "static/images/docs", "dest": "images", "svg_only": true }
          ],
          "exclude_dirs": ["doc-contributor-tools"]
        }
      ]
    },
    {
      "slug": "etcd",
      "name": "etcd",
      "layer": "Orchestration & Core",
      "layer_slug": "orchestration-core",
      "format": "markdown",
      "website": "https://etcd.io/docs/",
      "sources": [
        {
          "repo": "etcd-io/website",
          "branch": "main",
          "version_resolver": {
            "type": "yaml_key",
            "config_file": "config.yaml",
            "regex": "latest_stable_version:\\s*[\"']?(v[0-9.]+)[\"']?",
            "path_template": "content/en/docs/{version}",
            "fallback_parent": "content/en/docs",
            "fallback_regex": "^v\\d+\\.\\d+$"
          },
          "paths": [
            { "src": "{resolved_path}", "dest": "" }
          ]
        }
      ]
    },
    {
      "slug": "containerd",
      "name": "containerd",
      "layer": "Orchestration & Core",
      "layer_slug": "orchestration-core",
      "format": "markdown",
      "website": "https://containerd.io/docs/",
      "sources": [
        {
          "repo": "containerd/containerd",
          "branch": "main",
          "paths": [
            { "src": "docs", "dest": "" }
          ],
          "exclude_dirs": ["historical"]
        }
      ]
    },
